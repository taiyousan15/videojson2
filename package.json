{
  "name": "videojson",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "schema:validate": "node scripts/validate-examples.mjs",
    "narration:validate": "node scripts/validate-narration.mjs",
    "validate": "npm run schema:validate && node scripts/validate-narration.mjs --structure examples/minimal/structure.json --narration examples/minimal/narration.md",
    "validate:semantic": "node scripts/validate-semantic.mjs",
    "validate:policy": "node scripts/validate-policy.mjs",
    "render:generate": "node scripts/generate-render.mjs",
    "render:bootstrap": "node scripts/bootstrap-smoke-assets.mjs",
    "render:materialize": "node scripts/materialize-render.mjs",
    "render:ffmpeg": "node scripts/render-ffmpeg.mjs",
    "render:smoke": "npm run render:bootstrap && npm run render:materialize -- --render examples/smoke/render.json && npm run render:ffmpeg -- --render examples/smoke/render.materialized.json",
    "render:run": "node scripts/render-run.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@google-cloud/storage": "^7.7.0",
    "@google-cloud/tasks": "^5.1.0",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^3.0.3",
    "fast-json-patch": "^3.1.1",
    "next": "^16.1.1",
    "next-auth": "^5.0.0-beta.30",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20"
  }
}
