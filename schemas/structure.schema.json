{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://videojson.dev/schemas/structure.schema.json",
  "title": "VideoJSON Structure (Event JSON)",
  "type": "object",
  "required": [
    "schema_version",
    "video",
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "video": {
      "type": "object",
      "required": [
        "source_type",
        "source",
        "duration_ms",
        "language"
      ],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "type": "string",
          "enum": [
            "youtube",
            "upload",
            "transcript",
            "manual"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string"
        },
        "channel": {
          "type": "string"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        }
      }
    },
    "style_reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "notes": {
          "type": "string"
        },
        "telop_style": {
          "type": "string"
        },
        "font_hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "color_hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        },
        "transition_hints": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 20
        }
      }
    },
    "entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "speakers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_\\-]+$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "start_ms",
          "end_ms",
          "type",
          "summary"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s\\d{2,4}$"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "intro",
              "talk",
              "demo",
              "broll",
              "cta",
              "outro"
            ]
          },
          "speaker_id": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "key_points": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 20
          },
          "on_screen_text": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "text",
                "start_ms",
                "end_ms"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "position_hint": {
                  "type": "string"
                },
                "style_hint": {
                  "type": "string"
                }
              }
            }
          },
          "visual_hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
