{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://videojson.dev/schemas/transcript.schema.json",
  "title": "VideoJSON Transcript Schema",
  "description": "Schema for transcription data from YouTube captions, Whisper, or other sources",
  "type": "object",
  "required": ["schema_version", "items"],
  "properties": {
    "schema_version": {
      "type": "string",
      "description": "Schema version",
      "enum": ["1.0.0"]
    },
    "source": {
      "type": "object",
      "description": "Source information",
      "properties": {
        "type": {
          "type": "string",
          "description": "Source type",
          "enum": ["youtube", "whisper", "manual", "other"]
        },
        "url": {
          "type": "string",
          "description": "Source URL (if applicable)"
        },
        "video_id": {
          "type": "string",
          "description": "Video identifier"
        },
        "title": {
          "type": "string",
          "description": "Video title"
        },
        "duration_ms": {
          "type": "integer",
          "description": "Total duration in milliseconds",
          "minimum": 0
        }
      }
    },
    "language": {
      "type": "string",
      "description": "Language code (ISO 639-1) or 'auto' for auto-detected",
      "pattern": "^([a-z]{2}(-[A-Z]{2})?|auto)$",
      "examples": ["ja", "en", "en-US", "auto"]
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when transcript was generated"
    },
    "items": {
      "type": "array",
      "description": "Transcript items with timestamps",
      "items": {
        "type": "object",
        "required": ["start_ms", "end_ms", "text"],
        "properties": {
          "start_ms": {
            "type": "integer",
            "description": "Start time in milliseconds",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "description": "End time in milliseconds",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "description": "Transcribed text"
          },
          "confidence": {
            "type": "number",
            "description": "Confidence score (0-1)",
            "minimum": 0,
            "maximum": 1
          },
          "speaker": {
            "type": "string",
            "description": "Speaker identifier (if available)"
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
