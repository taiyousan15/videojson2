{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://videojson.dev/schemas/render.schema.json",
  "title": "VideoJSON Render Plan",
  "type": "object",
  "required": [
    "schema_version",
    "render_mode",
    "output",
    "segments"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "render_mode": {
      "type": "string",
      "enum": [
        "remix",
        "generative",
        "hybrid"
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "format",
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "mp4"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 16
        },
        "height": {
          "type": "integer",
          "minimum": 16
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "maximum": 120
        },
        "audio_sample_rate": {
          "type": "integer",
          "minimum": 8000
        },
        "filename": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "video",
              "audio",
              "image",
              "font",
              "subtitle"
            ]
          },
          "uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "meta": {
            "type": "object",
            "properties": {
              "consent": {
                "type": "boolean",
                "description": "Whether explicit consent was given for this asset (required for lipsync face assets)"
              },
              "consent_scope": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["lipsync", "voice_conversion", "general"]
                },
                "description": "Specific use cases consent was given for"
              },
              "source": {
                "type": "string",
                "description": "Source of the asset (e.g., 'self', 'stock', 'licensed')"
              }
            }
          }
        }
      }
    },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "voice_id": {
              "type": "string"
            },
            "language": {
              "type": "string"
            }
          }
        },
        "voice_conversion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "source_voice_asset_id": {
              "type": "string"
            },
            "target_profile_id": {
              "type": "string"
            }
          }
        },
        "lipsync": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "target_face_image_asset_id": {
              "type": "string"
            },
            "strength": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "video_generation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string"
            },
            "model": {
              "type": "string"
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_ms",
          "video",
          "audio"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s\\d{2,4}$"
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 100
          },
          "video": {
            "type": "object",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "reuse_original",
                  "generate",
                  "static_image",
                  "lipsync"
                ]
              },
              "lipsync": {
                "type": "object",
                "additionalProperties": false,
                "description": "Lipsync configuration (required when mode=lipsync)",
                "properties": {
                  "face_asset_id": {
                    "type": "string",
                    "description": "Asset ID of the face image to animate"
                  },
                  "provider": {
                    "type": "string",
                    "description": "Lipsync provider name (default: from config/env)"
                  },
                  "crop": {
                    "type": "string",
                    "enum": ["center", "fit", "fill"],
                    "default": "center"
                  },
                  "watermark": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "enabled": {
                        "type": "boolean",
                        "default": true
                      },
                      "text": {
                        "type": "string",
                        "default": "AI Generated"
                      }
                    }
                  }
                },
                "required": ["face_asset_id"]
              },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "asset_id": {
                    "type": "string"
                  },
                  "in_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "out_ms": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "prompt": {
                    "type": "string"
                  }
                }
              },
              "transform": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "crop": {
                    "type": "string"
                  },
                  "scale": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 10
                  },
                  "position": {
                    "type": "string"
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "mode": { "const": "generate" } }
                },
                "then": {
                  "properties": {
                    "source": {
                      "required": ["prompt"]
                    }
                  },
                  "required": ["source"]
                }
              },
              {
                "if": {
                  "properties": { "mode": { "const": "lipsync" } }
                },
                "then": {
                  "required": ["lipsync"]
                }
              }
            ]
          },
          "audio": {
            "type": "object",
            "required": [
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "use_original",
                  "tts",
                  "voice_conversion",
                  "uploaded"
                ]
              },
              "speaker_profile_id": {
                "type": "string"
              },
              "script": {
                "type": "string"
              },
              "asset_id": {
                "type": "string"
              },
              "lipsync": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "target_face_image_asset_id": {
                    "type": "string"
                  }
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "mode": { "const": "tts" } }
                },
                "then": {
                  "required": ["script"]
                }
              },
              {
                "if": {
                  "properties": { "mode": { "const": "uploaded" } }
                },
                "then": {
                  "required": ["asset_id"]
                }
              }
            ]
          },
          "overlays": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "captions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "style": {
                    "type": "string"
                  }
                }
              },
              "telops": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "text",
                    "start_ms",
                    "end_ms"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "start_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end_ms": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "style_hint": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
