# ===========================================
# VideoJSON Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Required fields are marked with [REQUIRED]
# ===========================================

# ===========================================
# Database (PostgreSQL) [REQUIRED]
# ===========================================
DATABASE_URL="postgresql://videojson:videojson@localhost:5435/videojson?schema=public"

# Docker Compose settings
POSTGRES_USER=videojson
POSTGRES_PASSWORD=videojson
POSTGRES_DB=videojson
POSTGRES_PORT=5435

# ===========================================
# Google Cloud Platform [REQUIRED for production]
# ===========================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=asia-northeast1
GCS_BUCKET=your-gcs-bucket
GCP_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Path to service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ===========================================
# Worker [REQUIRED]
# ===========================================
WORKER_URL=http://localhost:8080
WORKER_PORT=8080

# ===========================================
# AI Services - Video Understanding
# ===========================================
# TwelveLabs (Video Understanding AI)
# Get from: https://twelvelabs.io
# [OPTIONAL] - Only needed for video understanding features
TWELVELABS_API_KEY=your-twelvelabs-api-key
TWELVELABS_INDEX_ID=your-index-id

# ===========================================
# AI Services - Multimodal LLM [REQUIRED - choose at least one]
# ===========================================
# Google Gemini (Multimodal Analysis)
# Get from: https://aistudio.google.com
GOOGLE_AI_API_KEY=your-google-ai-api-key

# Anthropic Claude (Structured Output)
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (GPT-4o, Whisper STT)
# Get from: https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key

# ===========================================
# AI Services - Video Generation [OPTIONAL]
# ===========================================
# Runway (Video Generation)
# Get from: https://runwayml.com
RUNWAY_API_KEY=your-runway-api-key

# ===========================================
# AI Services - Image Generation [OPTIONAL]
# ===========================================
# Replicate (Flux, Stable Diffusion, etc.)
# Get from: https://replicate.com
REPLICATE_API_TOKEN=your-replicate-api-token

# ComfyUI (Local Image/Video Generation)
# Set to your local ComfyUI server URL
COMFYUI_URL=http://localhost:8188

# ===========================================
# AI Services - Text-to-Speech [OPTIONAL]
# ===========================================
# ElevenLabs (TTS)
# Get from: https://elevenlabs.io
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ===========================================
# AI Services - Face Recognition [OPTIONAL]
# ===========================================
# AWS Rekognition
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-northeast-1

# ===========================================
# Authentication [REQUIRED]
# ===========================================
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth [OPTIONAL]
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===========================================
# Logging & Debug
# ===========================================
LOG_LEVEL=info
NODE_ENV=development

# ===========================================
# Minimal Setup for Local Development
# ===========================================
# For a minimal local setup, you only need:
# 1. DATABASE_URL (with Docker Compose)
# 2. NEXTAUTH_SECRET (generate with openssl)
# 3. At least one LLM API key (ANTHROPIC_API_KEY or OPENAI_API_KEY)
#
# Optional but recommended:
# 4. GCS_BUCKET (for file storage, can use local for dev)
# 5. COMFYUI_URL (if running local ComfyUI)
