{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "event.json",
  "title": "Event JSON Schema v1.1",
  "type": "object",
  "required": ["version", "videoId", "duration", "chapters", "events"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1.1"
    },
    "videoId": {
      "type": "string",
      "format": "uuid"
    },
    "duration": {
      "type": "number",
      "minimum": 0
    },
    "chapters": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/chapter"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/event"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/entity"
      }
    },
    "onScreenTexts": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/onScreenText"
      }
    }
  },
  "definitions": {
    "chapter": {
      "type": "object",
      "required": ["id", "start", "end", "title"],
      "properties": {
        "id": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "title": { "type": "string" },
        "summary": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "start", "end", "type"],
      "properties": {
        "id": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "entities": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "entity": {
      "type": "object",
      "required": ["id", "type", "name"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["PERSON", "OBJECT", "LOCATION", "BRAND"] },
        "name": { "type": "string" },
        "embeddings": {
          "type": "array",
          "items": { "type": "number" }
        },
        "linkedTo": { "type": "string" }
      }
    },
    "onScreenText": {
      "type": "object",
      "required": ["id", "start", "end", "text", "bbox"],
      "properties": {
        "id": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string" },
        "bbox": {
          "type": "object",
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number" },
            "y": { "type": "number" },
            "width": { "type": "number" },
            "height": { "type": "number" }
          }
        }
      }
    }
  }
}
