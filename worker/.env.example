# ===========================================
# VideoJSON Worker - 環境変数設定
# ===========================================
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env

# -------------------------------------------
# 必須設定 (Required)
# -------------------------------------------

# PostgreSQL データベース接続文字列
# ※ docker-composeはポート5435を使用
DATABASE_URL=postgresql://videojson:videojson@localhost:5435/videojson

# -------------------------------------------
# 基本設定 (Basic - defaults provided)
# -------------------------------------------

# サーバーポート (default: 8080)
PORT=8080

# 環境 (development / staging / production)
NODE_ENV=development

# -------------------------------------------
# Google Cloud Platform
# -------------------------------------------

# GCPプロジェクトID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# GCS バケット名 (default: videojson-artifacts)
GCS_BUCKET=your-bucket-name

# サービスアカウント認証情報JSONファイルのパス
# Cloud Run等では不要（自動認証）
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# -------------------------------------------
# AI / LLM プロバイダー
# -------------------------------------------

# Google Gemini (動画解析・テキスト生成)
# https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-gemini-api-key

# OpenAI (GPT-4, Whisper音声認識)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# OpenRouter (複数AIプロバイダーの統合ゲートウェイ)
# https://openrouter.ai/keys
# 設定するとOpenAI互換のテキスト生成がOpenRouter経由になります
# ※注意: Whisper(音声認識)とEmbeddings(ベクトル化)はOpenRouter非対応
#   これらの機能を使う場合は、OPENAI_API_KEYも別途設定してください
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# OPENROUTER_SITE_NAME=VideoJSON
# OPENROUTER_SITE_URL=https://your-site.com

# Anthropic Claude (テキスト生成)
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# -------------------------------------------
# 動画/画像生成サービス
# -------------------------------------------

# ComfyUI (ローカル画像生成)
# ローカルで実行する場合: http://localhost:8188
COMFYUI_URL=http://localhost:8188

# Replicate (クラウド画像生成)
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_your-replicate-token

# Runway (動画生成)
# https://runwayml.com/
RUNWAY_API_KEY=your-runway-api-key

# -------------------------------------------
# 音声サービス
# -------------------------------------------

# ElevenLabs (音声合成/TTS)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# -------------------------------------------
# 動画理解・解析サービス
# -------------------------------------------

# TwelveLabs (動画インデックス・検索)
# https://twelvelabs.io/
TWELVELABS_API_KEY=your-twelvelabs-api-key
TWELVELABS_INDEX_ID=your-index-id

# InsightFace (顔検出・追跡)
# ローカルまたはCloud Runで実行
INSIGHTFACE_ENDPOINT=http://localhost:8001

# -------------------------------------------
# Cloud Vision OCR
# GOOGLE_APPLICATION_CREDENTIALS があれば自動認証
# -------------------------------------------

# -------------------------------------------
# 開発・デバッグ設定
# -------------------------------------------

# ログレベル (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
